# 手动启动时用：复制为 env.sh，填好 Key，然后 source 一下再启动
#   cp env.sh.example env.sh
#   vim env.sh          # 填 Key
#   source env.sh
#   ./ai-backend

# ============ 必填：你的 DeepSeek Token ============
# 获取：platform.deepseek.com → 注册 → 实名认证 → API Keys → 创建（只显示一次！）
# 不填也能跑：普通聊天正常，只有 @AI 会提示未配置
export DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"

# ============ 可选 ============
export DEEPSEEK_MODEL="deepseek-flash"   # 或 deepseek-v4-pro（老名字 deepseek-chat 已退役）
export THINKING="off"                    # on = 开启思维链（聊天室里不展示，避免刷屏）
export REASONING_EFFORT="medium"

# 监听地址：0.0.0.0 才能公网访问（你当前用 8082）
export LISTEN_ADDR="0.0.0.0:8082"

# 静态前端目录
# - 单进程跑法：填上网页目录，网页+API+WS 都由这一个进程提供（推荐，无跨域问题）
# - 前后端分离跑法（网页在 80 / 后端在 8082）：留空，但后端必须已加 CORS（代码已加）
export STATIC_DIR=""

# AI 调用限流（按用户名计）——@AI 才消耗余额，普通聊天不花钱
export RATE_LIMIT_PER_MIN="20"

# 新成员进房时 AI 主动欢迎：on / off
# 同样消耗 token；同一用户 5 分钟内只欢迎一次（防止反复刷新刷屏）
export AI_WELCOME="on"

# 前面挂了可信反代才设 on；裸奔必须 off，否则伪造头可绕过限流
export TRUST_PROXY="off"
