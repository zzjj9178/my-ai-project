<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>[__STUDENT_NAME__]的AI智能主页</title>
    <style>
        /* CSS样式与您提供的最终版完全相同，此处为简洁省略 */
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; background-color: #f0f2f5; color: #333; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; padding: 20px; box-sizing: border-box; } .main-container { display: flex; gap: 40px; width: 100%; max-width: 1200px; align-items: stretch; } .card { background-color: white; border-radius: 15px; box-shadow: 0 10px 20px rgba(0,0,0,0.1); padding: 40px; text-align: center; transition: transform 0.3s; flex: 0 0 400px; align-self: center; } .card:hover { transform: translateY(-10px); } .avatar { width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 5px solid #fff; box-shadow: 0 0 15px rgba(0,0,0,0.2); } h1 { margin-top: 20px; font-size: 2.5em; color: #1a1a1a; } h2 { font-size: 1.2em; color: #666; font-weight: 300; } .bio { margin-top: 20px; font-size: 1em; line-height: 1.6; } .chatbox { background: white; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.2); display: flex; flex-direction: column; flex: 1; height: 85vh; max-height: 800px; overflow: hidden; } .chat-header { background: #007bff; color: white; padding: 15px; text-align: center; font-weight: bold; } .chat-body { padding: 15px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; flex-grow: 1; } .chat-input { display: flex; border-top: 1px solid #eee; align-items: flex-end; padding: 8px; } #new-chat-btn { background: #f0f2f5; border: 1px solid #ddd; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background-color 0.2s; margin-left: 8px; flex-shrink: 0; } #new-chat-btn:hover { background: #e9e9eb; } #new-chat-btn svg { width: 20px; height: 20px; } textarea#user-input { border: none; flex-grow: 1; outline: none; resize: none; overflow-y: hidden; padding: 10px; font-size: 1em; font-family: inherit; line-height: 1.5; max-height: 150px; background: #f0f2f5; border-radius: 8px; box-sizing: border-box; } button#send-btn { background: #007bff; color: white; border: none; padding: 0 20px; height: 44px; cursor: pointer; transition: background-color 0.2s; border-radius: 8px; margin-left: 8px; flex-shrink: 0; } button#send-btn:disabled { background: #6c757d; cursor: not-allowed; } button#send-btn.stop-btn { background-color: #dc3545; } .message { padding: 10px 15px; border-radius: 20px; max-width: 90%; line-height: 1.5; white-space: pre-wrap; word-break: break-word; } .user-message { background: #007bff; color: white; align-self: flex-end; } .bot-message { background: #e9e9eb; color: #333; align-self: flex-start; }
    </style>
</head>
<body>
    <div class="main-container">
        <div class="card">
            <img src="images/__STUDENT_PHOTO__" alt="个人头像" class="avatar">
            <h1>[__STUDENT_NAME__]</h1>
            <h2>[__STUDENT_SCHOOL__] - [__STUDENT_MAJOR__]</h2>
            <p class="bio">
                大家好！我是一名对云原生和AI技术充满热情的大学生。
                <br>
                欢迎和我右边的 **本地大模型助手** 聊天！
            </p>
        </div>
        <div class="chatbox">
            <div class="chat-header">我的AI助手</div>
            <div class="chat-body" id="chat-body"></div>
            <div class="chat-input">
                <textarea id="user-input" placeholder="输入消息... Shift+Enter 换行" rows="1"></textarea>
                <button id="new-chat-btn" title="开启新会话">
                    <svg viewBox="0 0 24 24">
                        <path fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14" />
                    </svg>
                </button>
                <button id="send-btn">发送</button>
            </div>
        </div>
    </div>
    <script>
        // JavaScript与您提供的最终版完全相同，此处为简洁省略
        const chatBody = document.getElementById('chat-body'); const userInput = document.getElementById('user-input'); const sendBtn = document.getElementById('send-btn'); const newChatBtn = document.getElementById('new-chat-btn'); let eventSource; let sessionID; function startNewSession() { if (eventSource) { eventSource.close(); } const hasHistory = chatBody.querySelector('.user-message') !== null; chatBody.innerHTML = ''; if (hasHistory) { appendMessage("你好！新会话已开始，我们可以聊点新的话题了。", 'bot'); } else { appendMessage("你好！我是一个真正的大语言模型，由 llama.cpp 驱动。我们可以聊任何话题！", 'bot'); } sessionID = `session_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`; console.log("New session started with ID:", sessionID); resetInputState(); } function autoGrow(element) { element.style.height = 'auto'; element.style.height = (element.scrollHeight) + 'px'; } userInput.addEventListener('input', () => autoGrow(userInput)); function resetInputState() { userInput.disabled = false; sendBtn.disabled = false; userInput.placeholder = "输入消息... Shift+Enter 换行"; sendBtn.textContent = "发送"; sendBtn.classList.remove('stop-btn'); userInput.focus(); userInput.style.height = 'auto'; } function sendMessage() { const question = userInput.value.trim(); if (!question) return; userInput.disabled = true; sendBtn.textContent = "停止"; sendBtn.classList.add('stop-btn'); appendMessage(question, 'user'); userInput.value = ''; autoGrow(userInput); const botMessageDiv = appendMessage('', 'bot'); const url = `/ask-stream?session_id=${sessionID}&question=${encodeURIComponent(question)}`; eventSource = new EventSource(url); eventSource.onmessage = function(event) { const data = JSON.parse(event.data); if (data.error) { botMessageDiv.textContent = data.error; eventSource.close(); resetInputState(); } else if (data.content) { botMessageDiv.textContent += data.content; chatBody.scrollTop = chatBody.scrollHeight; } }; eventSource.onerror = function(err) { console.log("EventSource closed or an error occurred."); eventSource.close(); resetInputState(); }; } function stopStreaming() { if (eventSource) { eventSource.close(); resetInputState(); console.log("Stream manually stopped by user."); } } function appendMessage(text, type) { const messageDiv = document.createElement('div'); messageDiv.classList.add('message', type + '-message'); messageDiv.textContent = text; chatBody.appendChild(messageDiv); chatBody.scrollTop = chatBody.scrollHeight; return messageDiv; } sendBtn.addEventListener('click', () => { if (sendBtn.textContent === "发送") { sendMessage(); } else { stopStreaming(); } }); userInput.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); if (sendBtn.textContent === "发送") { sendMessage(); } } }); newChatBtn.addEventListener('click', startNewSession); document.addEventListener('DOMContentLoaded', () => { sessionID = `session_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`; console.log("Initial session started with ID:", sessionID); startNewSession(); });
    </script>
</body>
</html>
